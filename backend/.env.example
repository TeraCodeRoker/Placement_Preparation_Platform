# PrepStack backend configuration — copy to `.env` and fill real values.
# NEVER commit a real .env. All values below are placeholders/dev defaults.
#
# Quoting: optional — python-dotenv strips matched "..." or '...'.
# But NEVER put a trailing #comment after an EMPTY value: dotenv would read the
# comment text itself as the value. Empty means empty; comments go on their own line.

# --- App ---
APP_ENV=local            # local | dev | prod
DEBUG=true
# DJANGO_SECRET_KEY is optional; falls back to JWT_SECRET.
DJANGO_SECRET_KEY=

# --- Database (ADR-002) — Django URL scheme ---
# Local/dev may use SQLite; PRODUCTION MUST be Postgres (Neon), e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

# --- Gemini (§10) — rotate any leaked key before use ---
# Placeholder only. Put the REAL key in .env (gitignored), never in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_S=30

# --- Auth (ADR-004) ---
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-16-chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
ADMIN_BOOTSTRAP_EMAIL=

# --- Guest sessions (ADR-003) + MCQ cache ---
GUEST_TTL_DAYS=7
MCQ_CACHE_TTL_HOURS=24

# --- CORS (§9.1: comma-separated explicit origins, never "*") ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Code execution (ADR-005/ADR-020/§11) ---
# Default: Paiza.io public runner — free, no account, no key, no payment.
EXECUTION_PROVIDER=paiza
PAIZA_URL=https://api.paiza.io
PAIZA_API_KEY=guest
# Alternative: Piston. The public emkc.org API is whitelist-only since 2026-02-15,
# so this is for a SELF-HOSTED instance (docker, free). Set PISTON_URL to yours.
PISTON_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=
# Alternative: Judge0 CE — needs a PAID RapidAPI key. Not required by default.
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
EXECUTION_TIMEOUT_S=10
EXECUTION_MAX_SOURCE_BYTES=65536
OA_WALL_CLOCK_S=25

# --- Rate limits (§9.1/§10.5) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI=20/minute
RATE_LIMIT_EXEC=10/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_STD=60/minute
